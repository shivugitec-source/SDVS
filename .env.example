# Generate each database password independently with: openssl rand -hex 32
# Use distinct 64-character hex values; hex avoids URI-reserved characters.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_BOOTSTRAP_PASSWORD
SDVS_MIGRATOR_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_MIGRATOR_PASSWORD
SDVS_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_RUNTIME_PASSWORD

# Compose overrides DATABASE_URL separately for the migrator and API containers.
# This SQLite URL is only the default for direct local development outside Compose.
DATABASE_URL=sqlite:///./devs.db
JWT_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
DEV_BOOTSTRAP=1
BOOTSTRAP_USERNAME=master-admin
BOOTSTRAP_PASSWORD=SET_A_UNIQUE_LONG_RANDOM_PASSWORD
BOOTSTRAP_NAME=SDVS Master Administrator
BOOTSTRAP_EMAIL=your-gmail-address@gmail.com
BOOTSTRAP_PHONE=+919876543210
OTP_SECRET=GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
OTP_TTL_MINUTES=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM=your-gmail-address@gmail.com
SMTP_STARTTLS=1
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=YOUR_TWILIO_SMS_NUMBER
STORAGE_DIR=./private_uploads
MAX_UPLOAD_MB=25
REQUIRE_R2=0
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
